# Brazil MCP Server — Variáveis de Ambiente
# Copie para .env e ajuste conforme necessário

# Ambiente
MCP_ENV=development
MCP_PORT=8000

# Rate limiting
FREE_TIER_DAILY_LIMIT=100
PAID_TIER_DAILY_LIMIT=10000

# APIs externas
BRASIL_API_BASE=https://brasilapi.com.br/api
AWESOME_API_BASE=https://economia.awesomeapi.com.br

# Monitoramento (opcional)
SENTRY_DSN=

# Telegram — alertas de monitoramento (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
