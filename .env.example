# Brazil MCP Server — Variáveis de Ambiente
# Copie para .env e ajuste conforme necessário

# Ambiente
MCP_ENV=development
MCP_PORT=8000

# APIs externas
BRASIL_API_BASE=https://brasilapi.com.br/api
EXCHANGE_RATE_API_BASE=https://open.er-api.com/v6

# Monitoramento (opcional)
SENTRY_DSN=

# Telegram — alertas de monitoramento (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Chave master ImpulsoX (acesso total, sem rate limit)
# IMPULSOX_MASTER_KEY=impulsox-master-YOUR_KEY_HERE
